{
  "entity": {
    "binary_sensor": {
      "target_reached": {
        "default": "mdi:water-check",
        "state": {
          "off": "mdi:water-percent"
        }
      }
    },
    "button": {
      "reset_filter": {
        "default": "mdi:air-filter"
      },
      "start_drying": {
        "default": "mdi:fan-chevron-up"
      },
      "stop_drying": {
        "default": "mdi:fan-off"
      }
    },
    "fan": {
      "vesync": {
        "state_attributes": {
          "preset_mode": {
            "state": {
              "advanced_sleep": "mdi:sleep",
              "auto": "mdi:fan-auto",
              "eco": "mdi:leaf",
              "pet": "mdi:paw",
              "sleep": "mdi:sleep",
              "turbo": "mdi:weather-tornado"
            }
          }
        }
      }
    },
    "number": {
      "off_timer": {
        "default": "mdi:timer-outline"
      }
    },
    "select": {
      "drying_level": {
        "default": "mdi:fan-chevron-up"
      }
    },
    "sensor": {
      "drying_status": {
        "default": "mdi:weather-windy",
        "state": {
          "idle": "mdi:pause-circle-outline",
          "stopped": "mdi:stop-circle-outline"
        }
      },
      "drying_time_remaining": {
        "default": "mdi:timer-sand"
      },
      "off_timer_remaining": {
        "default": "mdi:timer-sand"
      },
      "total_run_time": {
        "default": "mdi:clock-outline"
      },
      "external_sensor_status": {
        "default": "mdi:access-point"
      }
    }
  },
  "services": {
    "send_command": {
      "service": "mdi:console"
    },
    "update_devices": {
      "service": "mdi:update"
    }
  }
}
